if(BUILD_TESTING)
    add_test_executable(guest_memory_tests ${LIBS_INCLUDE_DIR}/tests/GuestMemory.cpp)
    target_include_directories(guest_memory_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_memory_tests PRIVATE libkernel libc)
    configure_windows_unwind(guest_memory_tests)
    add_dependencies(guest_memory_tests guest_memory_module)
    target_compile_definitions(guest_memory_tests PRIVATE GUEST_MEMORY_MODULE="$<TARGET_FILE:guest_memory_module>")
    if(WIN32)
        add_dependencies(guest_memory_tests guest_memory_elf0_module)
        target_compile_definitions(guest_memory_tests PRIVATE GUEST_MEMORY_ELF0_MODULE="$<TARGET_FILE:guest_memory_elf0_module>")
    endif()
    add_test(NAME guest_memory COMMAND guest_memory_tests)
    add_test(NAME guest_mmap_fixed_anonymous COMMAND guest_memory_tests fixed-anonymous)
    if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        add_test(NAME guest_mmap_executable COMMAND guest_memory_tests executable-mappings)
        set_tests_properties(guest_mmap_executable PROPERTIES TIMEOUT 20)
    endif()
    if(WIN32)
        set_tests_properties(guest_memory guest_mmap_fixed_anonymous guest_mmap_executable PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
    endif()
endif()
