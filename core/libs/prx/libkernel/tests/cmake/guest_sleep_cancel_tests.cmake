if(BUILD_TESTING)
    add_test_executable(guest_sleep_cancel_tests ${LIBS_INCLUDE_DIR}/tests/GuestSleepCancel.cpp)
    target_include_directories(guest_sleep_cancel_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(guest_sleep_cancel_tests PRIVATE libkernel libc)
    configure_windows_unwind(guest_sleep_cancel_tests)
    foreach(sleepCase IN ITEMS blocked disabled normal pending)
        add_test(NAME guest_sleep_cancel_${sleepCase} COMMAND guest_sleep_cancel_tests ${sleepCase})
        add_test(NAME guest_sleep_cancel_${sleepCase}_coarse COMMAND guest_sleep_cancel_tests ${sleepCase})
        set_tests_properties(guest_sleep_cancel_${sleepCase} guest_sleep_cancel_${sleepCase}_coarse PROPERTIES TIMEOUT 20)
        set_tests_properties(guest_sleep_cancel_${sleepCase}_coarse PROPERTIES ENVIRONMENT "APS5_COARSE_TIMED_WAITS=1")
        if(WIN32)
            set_tests_properties(guest_sleep_cancel_${sleepCase} guest_sleep_cancel_${sleepCase}_coarse PROPERTIES
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
    foreach(sleepApi IN ITEMS usleep nanosleep _nanosleep)
        foreach(sleepCase IN ITEMS blocked disabled normal pending pending_long)
            set(sleepTest guest_sleep_cancel_${sleepApi}_${sleepCase})
            add_test(NAME ${sleepTest} COMMAND guest_sleep_cancel_tests ${sleepCase} ${sleepApi})
            add_test(NAME ${sleepTest}_coarse COMMAND guest_sleep_cancel_tests ${sleepCase} ${sleepApi})
            set_tests_properties(${sleepTest} ${sleepTest}_coarse PROPERTIES TIMEOUT 20)
            set_tests_properties(${sleepTest}_coarse PROPERTIES ENVIRONMENT "APS5_COARSE_TIMED_WAITS=1")
            if(WIN32)
                set_tests_properties(${sleepTest} ${sleepTest}_coarse PROPERTIES
                    ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
            endif()
        endforeach()
    endforeach()
    foreach(sleepApi IN ITEMS sce_usleep sce_nanosleep sce_sleep)
        set(sleepTest guest_sleep_cancel_${sleepApi}_deferred)
        add_test(NAME ${sleepTest} COMMAND guest_sleep_cancel_tests deferred ${sleepApi})
        add_test(NAME ${sleepTest}_coarse COMMAND guest_sleep_cancel_tests deferred ${sleepApi})
        set_tests_properties(${sleepTest} ${sleepTest}_coarse PROPERTIES TIMEOUT 20)
        set_tests_properties(${sleepTest}_coarse PROPERTIES ENVIRONMENT "APS5_COARSE_TIMED_WAITS=1")
        if(WIN32)
            set_tests_properties(${sleepTest} ${sleepTest}_coarse PROPERTIES
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libkernel>")
        endif()
    endforeach()
endif()
