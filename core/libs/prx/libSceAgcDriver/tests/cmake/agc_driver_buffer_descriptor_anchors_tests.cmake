if(BUILD_TESTING)
    set(agcBufferDescriptorAnchorTests agc_driver_buffer_descriptor_anchors)
    foreach(mode IN ITEMS counter32 counter64 waterfall32 waterfall64)
        if(NOT mode STREQUAL "counter32")
            add_test(NAME agc_driver_buffer_descriptor_anchors_${mode} COMMAND agc_driver_buffer_descriptor_anchors_tests --${mode})
            list(APPEND agcBufferDescriptorAnchorTests agc_driver_buffer_descriptor_anchors_${mode})
        endif()
        add_test(NAME agc_driver_buffer_descriptor_anchors_${mode}_coherent COMMAND agc_driver_buffer_descriptor_anchors_tests --${mode} --coherent)
        list(APPEND agcBufferDescriptorAnchorTests agc_driver_buffer_descriptor_anchors_${mode}_coherent)
    endforeach()
    foreach(mode IN ITEMS counter64 waterfall64)
        add_test(NAME agc_driver_buffer_descriptor_anchors_${mode}_split COMMAND agc_driver_buffer_descriptor_anchors_tests --${mode} --split)
        list(APPEND agcBufferDescriptorAnchorTests agc_driver_buffer_descriptor_anchors_${mode}_split)
    endforeach()
    add_test(NAME agc_driver_buffer_descriptor_anchors_required COMMAND agc_driver_buffer_descriptor_anchors_tests --require-anchors)
    add_test(NAME agc_driver_buffer_descriptor_anchors_bytes COMMAND agc_driver_buffer_descriptor_anchors_tests)
    list(APPEND agcBufferDescriptorAnchorTests agc_driver_buffer_descriptor_anchors_required agc_driver_buffer_descriptor_anchors_bytes)
    set_tests_properties(${agcBufferDescriptorAnchorTests} PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    set_property(TEST agc_driver_buffer_descriptor_anchors_bytes APPEND PROPERTY ENVIRONMENT "APS5_BDA_BYTE_READS=1")
    if(WIN32)
        set_tests_properties(${agcBufferDescriptorAnchorTests} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
